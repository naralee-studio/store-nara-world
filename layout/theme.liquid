<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'meta-tags' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {% if request.page_type == 'product' or request.page_type == 'cart' or request.design_mode %}
      {{ 'nara-ui.css' | asset_url | stylesheet_tag }}
      <script type="module" src="{{ 'nara-ui.js' | asset_url }}"></script>
    {% endif %}
    {{ content_for_header }}
  </head>
  <body>
    <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  </body>
</html>
