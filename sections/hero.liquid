{% liquid
  assign featured_product = section.settings.product
  assign hero_image = section.settings.image | default: featured_product.featured_image
  assign destination = section.settings.link | default: featured_product.url | default: routes.all_products_collection_url
%}
<div class="hero full-width">
  <div class="hero-heading">
    <h1>{{ section.settings.heading | escape }}</h1>
    <div><p>{{ section.settings.text | escape }}</p><a class="text-link" href="{{ destination }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a></div>
  </div>
  <a class="hero-image" href="{{ destination }}" aria-label="{{ section.settings.link_label | escape }}">
    {% if hero_image %}
      {{ hero_image | image_url: width: 2400 | image_tag: widths: '640, 960, 1440, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high' }}
    {% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}
  </a>
</div>
{% schema %}
{"name":"Nara hero","settings":[{"type":"text","id":"heading","label":"Heading","default":"nara."},{"type":"textarea","id":"text","label":"Introduction","default":"A playful approach to modular living."},{"type":"product","id":"product","label":"Featured product"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"url","id":"link","label":"Link override"},{"type":"text","id":"link_label","label":"Link label","default":"Explore family."}],"presets":[{"name":"Nara hero"}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
