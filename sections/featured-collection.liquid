<div class="section-space">
  <div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ 'general.view_all' | t }} <span aria-hidden="true">↗</span></a></div>
  {% assign featured_collection = section.settings.collection | default: collections.all %}
  <div class="product-grid">
    {% for product in featured_collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<p>{{ 'collections.empty' | t }}</p>{% endfor %}
  </div>
</div>
{% schema %}
{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"The collection"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products","min":2,"max":12,"step":1,"default":4}],"presets":[{"name":"Featured collection"}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
