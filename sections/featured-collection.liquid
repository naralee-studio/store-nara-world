<div class="catalog-home">
  <h1 class="visually-hidden">{{ 'collections.title' | t }}</h1>
  {% assign featured_collection = section.settings.collection | default: collections.all %}
  {% render 'catalog-grid', collection: featured_collection, limit: section.settings.limit %}
</div>
{% schema %}
{"name":"Product list","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"limit","label":"Products per page","min":4,"max":48,"step":4,"default":12}],"presets":[{"name":"Product list"}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
