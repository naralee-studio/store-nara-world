<div class="section-space cart-page">
  <h1>{{ 'cart.title' | t }}</h1>
  {% if cart == empty %}
    <div class="empty-state"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a></div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <a href="{{ item.url }}" class="cart-image">{% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}<span class="visually-hidden">{{ item.product.title | escape }}</span></a>
            <div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
              {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
              {% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
              {% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% unless property.last == blank or first_character == '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endunless %}{% endfor %}
              <p>{{ item.final_price | money_with_currency }}</p>
              {% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}
              <a class="text-link" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
            <div class="cart-quantity" data-cart-quantity data-increment="{{ 'product.increment' | t | escape }}" data-decrement="{{ 'product.decrement' | t | escape }}" data-line-key="{{ item.key | escape }}" data-label="{{ 'product.quantity' | t | escape }} — {{ item.title | escape }}" data-invalid="{{ 'product.invalid_quantity' | t | escape }}">
              <div data-cart-fallback><label for="Quantity-{{ section.id }}-{{ forloop.index }}">{{ 'product.quantity' | t }}<span class="visually-hidden"> — {{ item.title | escape }}</span></label><input id="Quantity-{{ section.id }}-{{ forloop.index }}" type="number" name="updates[]" min="{{ item.variant.quantity_rule.min | default: 1 }}" step="{{ item.variant.quantity_rule.increment | default: 1 }}" {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %} value="{{ item.quantity }}" required></div>
              <div data-cart-mount></div>
            </div>
            <p class="line-total">{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money_with_currency }}</s> {% endif %}{{ item.final_line_price | money_with_currency }}</p>
          </div>
        {% endfor %}
      </div>
      <div class="cart-summary">
        <button type="submit" class="button-secondary">{{ 'cart.update' | t }}</button>
        {% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</p>{% endfor %}
        <p>{{ 'cart.subtotal' | t }} <strong>{{ cart.total_price | money_with_currency }}</strong></p>
        <p class="muted">{{ 'cart.shipping_at_checkout' | t }}</p>
        <button type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
      </div>
    </form>
  {% endif %}
</div>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
