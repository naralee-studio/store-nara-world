{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
  assign product_form_id = 'ProductForm-' | append: section.id
%}
<nara-product class="product-layout section-space" data-section-id="{{ section.id }}">
  <div class="product-gallery">
    {% if featured_image %}<div class="product-featured-image">{{ featured_image | image_url: width: 1600 | image_tag: widths: '480, 800, 1200, 1600', sizes: '(min-width: 900px) 60vw, 100vw', loading: 'eager' }}</div>{% endif %}
    <div class="product-thumbnails">
      {% for image in product.images %}<a href="{{ image | image_url: width: 2200 }}" data-gallery-image>{{ image | image_url: width: 320 | image_tag: loading: 'lazy' }}<span class="visually-hidden">{{ 'product.view_image' | t: number: forloop.index }}</span></a>{% endfor %}
    </div>
    {% for media in product.media %}{% unless media.media_type == 'image' %}{{ media | media_tag: controls: true }}{% endunless %}{% endfor %}
  </div>
  <div class="product-details">
    <p class="eyebrow">{{ product.vendor | escape }}</p>
    <h1>{{ product.title | escape }}</h1>
    <p class="product-price" aria-live="polite" data-price>{{ current_variant.price | money_with_currency }} {% if current_variant.compare_at_price > current_variant.price %}<s>{{ current_variant.compare_at_price | money_with_currency }}</s>{% endif %}</p>
    {% form 'product', product, id: product_form_id %}
      {{ form.errors | default_errors }}
      {% if product.has_only_default_variant %}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
      {% else %}
        <label for="Variant-{{ section.id }}">{{ product.options | join: ' / ' | escape }}</label>
        <select name="id" id="Variant-{{ section.id }}" data-variant-select>
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %}>{{ variant.title | escape }} · {{ variant.price | money_with_currency }}{% unless variant.available %} · {{ 'product.sold_out' | t }}{% endunless %}</option>
          {% endfor %}
        </select>
        <noscript><p>{{ 'product.no_script' | t }}</p>{% for variant in product.variants %}<a href="{{ product.url }}?variant={{ variant.id }}">{{ variant.title | escape }}</a> {% endfor %}</noscript>
      {% endif %}
      <label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label>
      <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}" {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %} value="{{ current_variant.quantity_rule.min | default: 1 }}" required>
      <button type="submit" name="add" class="add-to-cart" {% unless current_variant.available %}disabled{% endunless %}>{% if current_variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
      {% if section.settings.show_dynamic_checkout and current_variant.available %}{{ form | payment_button }}{% endif %}
    {% endform %}
    <div class="rte product-description">{{ product.description }}</div>
    {% for block in section.blocks %}{% render block %}{% endfor %}
  </div>
</nara-product>
{% schema %}
{"name":"Product","settings":[{"type":"checkbox","id":"show_dynamic_checkout","label":"Show accelerated checkout","default":false}],"blocks":[{"type":"@app"}],"disabled_on":{"groups":["header","footer"]}}
{% endschema %}
