<div class="catalog-home">
  <h1 class="visually-hidden">{{ collection.title | escape }}</h1>
  {% render 'catalog-grid', collection: collection, limit: section.settings.limit %}
</div>
{% schema %}
{"name":"Collection","settings":[{"type":"range","id":"limit","label":"Products per page","min":4,"max":48,"step":4,"default":12}]}
{% endschema %}
