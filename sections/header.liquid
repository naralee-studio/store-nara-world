<header class="site-header">
  <nav class="brand-nav" aria-label="Main navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        {% liquid
          assign menu_color = 'store'
          assign menu_url = link.url | remove: 'https://www.nara.world' | remove: 'https://nara.world' | remove: 'https://0b5c15c2.nara-world.pages.dev'
          case menu_url
            when '/', ''
              unless link.type == 'frontpage_link'
                assign menu_color = 'home'
              endunless
            when '/collection/', '/collection'
              assign menu_color = 'collection'
            when '/press/', '/press'
              assign menu_color = 'press'
            when '/about/', '/about'
              assign menu_color = 'about'
          endcase
          assign is_store = false
          if link.type == 'frontpage_link' or link.url == shop.url or link.url == 'https://store.nara.world/'
            assign is_store = true
            assign menu_color = 'store'
          endif
        %}
        <p><a class="brand-nav-{{ menu_color }}" href="{% if is_store %}{{ routes.root_url }}{% else %}{{ link.url | escape }}{% endif %}"{% if link.current %} aria-current="page"{% elsif is_store %} aria-current="true"{% endif %}>{{ link.title | escape }}</a></p>
      {% endfor %}
    {% else %}
    <p><a class="brand-nav-home" href="https://nara.world/">home</a></p>
    <p><a class="brand-nav-collection" href="https://nara.world/collection/">collection</a></p>
    <p><a class="brand-nav-store" href="{{ routes.root_url }}" aria-current="{% if request.page_type == 'index' %}page{% else %}true{% endif %}">store</a></p>
    <p><a class="brand-nav-press" href="https://nara.world/press/">press</a></p>
    <p><a class="brand-nav-about" href="https://nara.world/about/">about</a></p>
    {% endif %}
  </nav>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"link_list","id":"menu","label":"Navigation menu","info":"Select the navigation menu. When empty, the five nara.world links are shown."},{"type":"text","id":"brand","label":"Wordmark","default":"nara."}]}
{% endschema %}
