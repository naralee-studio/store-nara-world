<div class="section-space">
  <h1>{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <label class="visually-hidden" for="Search-{{ section.id }}">{{ 'search.placeholder' | t }}</label>
    <input id="Search-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <button type="submit">{{ 'search.submit' | t }}</button>
  </form>
  {% if search.performed %}
    {% assign safe_terms = search.terms | escape %}
    {% if search.results_count == 0 %}<p>{{ 'search.no_results_html' | t: terms: safe_terms }}</p>
    {% else %}
      <p>{{ 'search.results_for_html' | t: terms: safe_terms, count: search.results_count }}</p>
      {% paginate search.results by 20 %}
        <div class="product-grid search-results">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}{% render 'product-card', product: result %}
            {% else %}<article class="search-text-result"><p class="eyebrow">{{ result.object_type | escape }}</p><h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2><p>{{ result.content | strip_html | truncatewords: 25 | escape }}</p></article>{% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}<nav class="pagination" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>{% endif %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</div>
{% schema %}{"name":"Search","settings":[]}{% endschema %}
