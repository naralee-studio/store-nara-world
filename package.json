{
  "name": "store-nara-world",
  "version": "0.1.0",
  "private": true,
  "description": "Nara custom Shopify theme, based on the official Shopify Skeleton",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:sync": "node scripts/dev.mjs --theme-editor-sync",
    "check": "shopify theme check --fail-level warning",
    "theme:list": "shopify theme list --environment development",
    "theme:info": "shopify theme info --environment development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "assets:watch": "vite build --watch",
    "assets:check": "node scripts/check-assets.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@shopify/cli": "4.8.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.0.1",
    "liquidjs": "10.29.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.0",
    "@astryxdesign/theme-neutral": "0.6.0",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "type": "module"
}
