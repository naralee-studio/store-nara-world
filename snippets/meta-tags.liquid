<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign seo_description = page_description
  if seo_description == blank and request.page_type == 'product'
    assign seo_description = product.description | strip_html | strip_newlines | truncate: 160
  endif
  assign og_description = seo_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{% capture sale_status %}{% render 'product-for-sale', product: product %}{% endcapture %}
{%- if request.page_type == 'product' and sale_status == 'true' -%}
  {% capture json_lt %}\u003c{% endcapture %}
  <script type="application/ld+json">
    {{ product | structured_data | replace: '<', json_lt }}
  </script>

  <meta
    property="product:price:amount"
    content="{{ product.selected_or_first_available_variant.price | default: product.price | divided_by: 100.0 }}"
  >
  <meta
    property="product:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- elsif request.page_type == 'product' -%}
  {% capture catalog_schema %}
    {"@context":"https://schema.org","@type":"Product","name":{{ product.title | json }},"url":{{ canonical_url | json }},"description":{{ product.description | strip_html | json }},"image":{{ product.featured_image | image_url: width: 1600 | prepend: 'https:' | json }},"brand":{"@type":"Brand","name":"nara."}}
  {% endcapture %}
  {% capture json_lt %}\u003c{% endcapture %}
  <script type="application/ld+json">{{ catalog_schema | replace: '<', json_lt }}</script>
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description != blank %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}

{% render 'site-structured-data', description: og_description %}
