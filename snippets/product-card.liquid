{% doc %}
  Renders a product image, title, availability, and localized price.
  @param {product} product - Product to display
{% enddoc %}
<article class="product-card">
  <a href="{{ product.url }}" class="product-card-image">
    {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | image_tag: widths: '360, 640, 960, 1200', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
    <span class="visually-hidden">{{ product.title | escape }}</span>
  </a>
  <div class="product-card-caption">
    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    {% capture sale_status %}{% render 'product-for-sale', product: product %}{% endcapture %}
    {% if sale_status == 'true' %}<p>{% if product.price_varies %}{{ 'product.from' | t }} {% endif %}{{ product.price | money_with_currency }}{% unless product.available %} · {{ 'product.sold_out' | t }}{% endunless %}</p>{% endif %}
  </div>
</article>
